# ===== 应用配置 =====
APP_ENV=dev
APP_DEBUG=true
APP_NAME=local-life-server
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== JWT 配置 =====
JWT_SECRET_KEY=change-me-in-production-please-use-a-strong-secret
JWT_ALGORITHM=HS256
JWT_USER_TOKEN_EXPIRE_DAYS=7
JWT_ADMIN_TOKEN_EXPIRE_HOURS=2

# ===== MySQL 配置 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=local_life
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

# ===== Redis 配置 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== MongoDB 配置 =====
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=local_life

# ===== Elasticsearch 配置 =====
ES_HOST=127.0.0.1
ES_PORT=9200
ES_USER=
ES_PASSWORD=

# ===== MinIO 配置 =====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=local-life
MINIO_SECURE=false

# ===== RabbitMQ 配置 =====
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ===== 第三方服务密钥 =====
# 高德地图
AMAP_API_KEY=
# 和风天气
QWEATHER_API_KEY=
# OpenAI 兼容接口（通义/DeepSeek/智谱）
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo
# 极光推送
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
# 阿里云内容安全
ALIYUN_CENSOR_ACCESS_KEY=
ALIYUN_CENSOR_ACCESS_SECRET=

# ===== 限流配置 =====
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_LOGIN=5/minute